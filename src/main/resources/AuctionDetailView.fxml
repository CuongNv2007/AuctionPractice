<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="500.0" prefWidth="650.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="PHIÊN ĐẤU GIÁ:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="lblItemName" text="Tên sản phẩm đấu giá" style="-fx-font-size: 16px; -fx-text-fill: #1a73e8;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTimeRemaining" text="Còn lại: 00:05:30" style="-fx-font-size: 14px; -fx-text-fill: red;"/>
    </HBox>
    <Separator/>

    <!-- Body -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Cột thông tin giá -->
        <VBox prefWidth="250.0" spacing="10.0">
            <Label text="Giá cao nhất hiện tại:" style="-fx-font-size: 14px;"/>
            <Label fx:id="lblCurrentPrice" text="1,500,000 VNĐ" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
            <Label fx:id="lblHighestBidder" text="Người giữ giá: Nguyễn Văn A"/>
            <Separator/>
            <Label fx:id="lblStartingPrice" text="Giá khởi điểm: 1,000,000 VNĐ"/>
            <Label fx:id="lblMinIncrement" text="Bước giá tối thiểu: +50,000 VNĐ"/>
        </VBox>

        <!-- Cột lịch sử đặt giá -->
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Lịch sử các lượt đặt giá:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="lvBidHistory" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <!-- Footer: Thao tác đặt giá -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label text="Mức giá đề xuất:"/>
        <TextField fx:id="txtBidAmount" prefWidth="200.0" promptText="Nhập số tiền..."/>
        <Button fx:id="btnPlaceBid" text="ĐẶT GIÁ" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>