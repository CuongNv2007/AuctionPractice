```xml
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1000" prefHeight="650">

    <top>
        <VBox spacing="10" style="-fx-background-color: #263238; -fx-padding: 20;">
            <Label text="AUCTION LOBBY"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Explore available auction sessions"
                   style="-fx-font-size: 14px; -fx-text-fill: #CFD8DC;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField promptText="Search auctions..." HBox.hgrow="ALWAYS"/>
                <ComboBox promptText="All Status" prefWidth="150"/>
                <Button text="Search"/>
            </HBox>

            <Label text="Available Auctions"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="8" style="-fx-background-color: #ECEFF1; -fx-padding: 15; -fx-background-radius: 8;"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Auction #001" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Product: Example Laptop"/>
                    <Label text="Current Price: 15,000,000 VND"/>
                    <Label text="Status: OPEN" style="-fx-text-fill: green;"/>
                    <Label text="Time remaining: 02:30:00"/>
                    <Button text="View Details"/>
                </VBox>

                <VBox spacing="8" style="-fx-background-color: #ECEFF1; -fx-padding: 15; -fx-background-radius: 8;"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Auction #002" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Product: Example Painting"/>
                    <Label text="Current Price: 8,000,000 VND"/>
                    <Label text="Status: RUNNING" style="-fx-text-fill: blue;"/>
                    <Label text="Time remaining: 00:45:00"/>
                    <Button text="View Details"/>
                </VBox>
            </GridPane>
        </VBox>
    </center>

</BorderPane>
```
